# ════════════════════════════════════════════════════
# Theatre Management System — Environment Variables
# ════════════════════════════════════════════════════

# ─── Server ─────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database ───────────────────────────────────────
# Local PostgreSQL connection string
DATABASE_URL=postgresql://theatre_user:theatre_pass_2025@localhost:5432/theatre_db?schema=public

# Docker-specific (used by docker-compose)
POSTGRES_DB=theatre_db
POSTGRES_USER=theatre_user
POSTGRES_PASSWORD=theatre_pass_2025

# ─── JWT Authentication ─────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=24h

# ─── Rate Limiting ──────────────────────────────────
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100
